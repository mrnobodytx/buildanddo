    "package-lock.json",
    "knip.json",
    ".gitignore",
    ".gitattributes",
    ".nvmrc",
    ".version",
    "BUILDANDDO_SOURCE_PROVENANCE.json",
    ".env.example",
    ".gitlab-ci.yml"
  ],
  "public_forbidden_prefixes": [
    "golden/",
    "infra/",
    "private/",
    "secrets/",
    "ops/private/",
    "sops/",
    "terraform/",
    "tofu/",
    "ansible/",
    "helm/",
    "flux/",
    "state/",
    "evidence/private/",
    "ci/buildanddo/"
