# Local secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Dependencies / build
node_modules/
dist/

# CI telemetry, lint and dead-code reports produced by scripts/ci/telemetry_snapshot.py
# and consumed by the Datadog publisher. Build output, never source.
reports/

# PocketBase runtime state
apps/pocketbase/pb_data/
apps/pocketbase/pb_snapshots/
apps/pocketbase/pocketbase

# OS/editor
.DS_Store
Thumbs.db
.vscode/*.local.json

# Local-only operational state / internal ops scripts (never public)
state/
evidence/**/private/
evidence/**/secrets/
.buildanddo/*
!.buildanddo/public/
!.buildanddo/public/**
.buildanddo/public/boundary-report.json
__pycache__/
*.pyc
# .buildanddo/public/path-policy.json is a public-safe allow/deny path list consumed by
# scripts/ci/verify_public_boundary.py - NOT sensitive, and it must ship to every clone
# (real bug found 2026-09-07: the blanket .buildanddo/ ignore above silently starved the
# scanner on every fresh checkout, including this repo's own GitLab CI runner).
# scripts/ci/sprint_cycle.py used to be ignored here. It is now tracked: it is
# the canonical sprint plan consumed by scripts/deploy/roadmap_status.py, it
# carries only data the public roadmap page already renders, and scripts/ci/ is
# a public_allowed_prefix in path-policy.json. Ignoring it made every clean
# checkout fail on `import sprint_cycle` (same class of bug as the line above).
# The PowerShell runner below stays ignored - it is a local operator convenience
# and nothing tracked imports it.
scripts/ci/run_sprint_cycle.ps1

# Private GitLab-mirror CI config - names an internal project path, must
# never land in the public GitHub repo. See .github/workflows/candidate-to-gitlab.yml
# for the sanctioned (secrets-only, no hardcoded path) public mirror mechanism.
/.gitlab-ci.yml

# Generated at build time by scripts/deploy/roadmap_status.py - never hand-edited
# or committed as source, it's build output like dist/.
apps/web/public/roadmap-status.json
apps/web/public/.well-known/citadel-release.json

# Local sensitive working area. NOT ignored before 2026-09-11: a bare
# `git add .` staged vault/temp/SESSION_JOURNAL.md into this repo, which
# pushes to PUBLIC github.com/mrnobodytx/buildanddo.
vault/
