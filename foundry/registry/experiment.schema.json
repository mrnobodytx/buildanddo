{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:buildanddo:foundry:experiment-v1",
  "title": "Public Foundry Reference Experiment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lane_id",
    "dataset",
    "dataset_sha256",
    "candidates",
    "seeds",
    "repetitions",
    "timeout_seconds",
    "requirement_ids",
    "scope",
    "purpose",
    "primary_metric",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "const": "foundry.experiment/v1"
    },
    "lane_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "dataset": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "dataset_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
      }
    },
    "repetitions": {
      "type": "integer",
      "minimum": 2,
      "maximum": 10
    },
    "timeout_seconds": {
      "type": "number",
      "minimum": 0.05,
      "maximum": 300
    },
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9][A-Z0-9._-]*$"
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "primary_metric": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/metric"
      }
    }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "unit",
        "direction"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "direction": {
          "enum": [
            "higher",
            "lower",
            "neutral"
          ]
        },
        "threshold": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operator",
            "value"
          ],
          "properties": {
            "operator": {
              "enum": [
                ">=",
                "<=",
                "=="
              ]
            },
            "value": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
