{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": [
    "apps/!(web)"
  ],
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "apps/web": {
      "entry": [
        "index.html",
        "src/main.jsx",
        "tools/*.{js,mjs}",
        "plugins/session-journal/session-journal-client.js",
        "plugins/site-pages/site-pages-script.js",
        "plugins/visual-editor/edit-mode-script.js"
      ],
      "project": [
        "src/**/*.{js,jsx}",
        "tools/**/*.{js,mjs}",
        "plugins/**/*.js"
      ],
      "paths": {
        "@/*": [
          "./src/*"
        ]
      },
      "ignoreDependencies": [
        "dd-trace"
      ],
      "ignoreUnresolved": [
        "./eslint.unicode-escapes-formatter.mjs"
      ]
    }
  }
}
