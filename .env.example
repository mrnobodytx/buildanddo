# BuildAndDo environment template.
#
#   cp .env.example .env      (./scripts/dev-setup.sh does this for you)
#
# .env is gitignored and must never be committed. Every value here is either
# empty or a local-development default - none of them are production values,
# and nothing in this file is a secret.
#
# Everything has a working default, so `docker compose up -d` works with no
# .env at all. Copy the file when you want to change a port, point the app at
# a different backend, or switch Datadog RUM on locally.

# ─────────────────────────────────────────────────────────────────────────────
# Frontend (apps/web) - VITE_* variables are compiled into the browser bundle.
# Never put a server secret in a VITE_* variable: it ships to every visitor.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED for local development. Read by apps/web/src/lib/pocketbaseClient.js.
# Docker default: the PocketBase container published on the host.
# Deployed default when unset: /hcgi/platform (same-origin reverse proxy).
VITE_POCKETBASE_API_URL=http://localhost:8090

# ─── Datadog RUM (optional) ──────────────────────────────────────────────────
# Client-side public identifiers, not secrets; the RUM client token is
# intake-scoped and carries no read access. Datadog org site: us5.datadoghq.com.
# Leave BOTH empty for local work: apps/web/src/lib/datadogRum.js skips
# initialisation when either is missing, so no local session reaches Datadog.
VITE_DD_APPLICATION_ID=
VITE_DD_CLIENT_TOKEN=

# Optional overrides. env is otherwise derived from the hostname, and version
# from the shipped commit (scripts/deploy/ship.py writes both at build time).
# The compose stack sets VITE_DD_ENV=local so local sessions are separable if
# RUM is ever enabled deliberately.
VITE_DD_ENV=local
VITE_DD_VERSION=

# Percentages, 0-100. Defaults: sessions 100, replay 20, backend trace
# propagation 20. Lower the replay rate first if RUM volume needs trimming.
VITE_DD_SESSION_SAMPLE_RATE=
VITE_DD_REPLAY_SAMPLE_RATE=
VITE_DD_TRACE_SAMPLE_RATE=

# Optional PostHog project key (apps/web/src/lib/telemetry.js). Empty disables
# product analytics, which is the correct local setting.
VITE_BUILDANDDO_PH=

# ─────────────────────────────────────────────────────────────────────────────
# PocketBase (apps/pocketbase) - server side, never exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED for the local stack. Read by
# pb_migrations/1764579159_create_superuser.js, which creates the admin account
# on first boot; the migration fails if either is empty.
#
# These are local development credentials for a container-only database. They
# must never match a deployed environment. PocketBase requires a password of at
# least 10 characters. Changing them after first boot has no effect on the
# existing account - recreate the volume instead:
#   docker compose down -v && ./scripts/dev-setup.sh
PB_SUPERUSER_EMAIL=admin@buildanddo.local
PB_SUPERUSER_PASSWORD=localdev-change-me

# Optional. pb_hooks/logs-forwarder.pb.js writes _logs rows to container stdout
# INSTEAD of the database when this is "production". "development" persists
# them, so they stay in the admin UI's Logs view - easier to read locally.
PB_NODE_ENV=development

# Optional PocketBase server version for the local image
# (apps/pocketbase/Dockerfile). Bump to try a newer server; the pinned default
# tracks the pocketbase JS SDK line in apps/web/package.json.
POCKETBASE_VERSION=0.28.4

# ─── Optional PocketBase hook integrations ───────────────────────────────────
# Outbound integrations used by apps/pocketbase/pb_hooks. Leave unset locally.
# Neither hook is guarded by these variables, so read
# docs/api/README.md ("Server-side hooks") before triggering the flows that
# call them: the mail hook raises a 500 when PocketBase SMTP is disabled and
# no mail API is configured, and the CRM hook logs its own failure and lets
# the early_access record save anyway.
BUILDER_MAILER_API_URL=
BUILDER_MAILER_API_KEY=
BUILDER_MAILER_SENDER_ADDRESS=
REACH_API_URL=
REACH_API_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Local stack (docker-compose.yml)
# ─────────────────────────────────────────────────────────────────────────────

# Host ports. Change these if 3000 or 8090 are already taken; the setup script
# reads them back when it prints URLs and probes health.
WEB_PORT=3000
POCKETBASE_PORT=8090

# Set to true if hot reload stops firing. Docker Desktop on macOS and Windows
# does not deliver native file events across bind mounts, so Vite needs polling
# there. It costs CPU, which is why it is off by default.
CHOKIDAR_USEPOLLING=false

# ─────────────────────────────────────────────────────────────────────────────
# Demo data (scripts/dev-seed.mjs, run by ./scripts/dev-setup.sh --seed)
# ─────────────────────────────────────────────────────────────────────────────

# The non-admin account the demo workspace belongs to. Local only; the seeder
# refuses to run against a non-local PB_URL.
DEMO_USER_EMAIL=demo@buildanddo.local
DEMO_USER_PASSWORD=demo-localdev-1234

# ─────────────────────────────────────────────────────────────────────────────
# Backend services (services/praxis_evidence) - only needed if you run the
# evidence fabric test suite. It authenticates as the PocketBase superuser and
# defaults to production, so point it at the local stack before running it.
# ─────────────────────────────────────────────────────────────────────────────
# PB_API_URL=http://localhost:8090
