# Frontend only. Do not place server secrets in VITE_* variables.
VITE_POCKETBASE_API_URL=https://buildanddo.com/hcgi/platform

# Datadog RUM (client-side public identifiers, not secrets).
# Datadog org site: us5.datadoghq.com
VITE_DD_APPLICATION_ID=
VITE_DD_CLIENT_TOKEN=
# Optional overrides; env is otherwise derived from the build mode/hostname.
VITE_DD_ENV=
VITE_DD_VERSION=
