# Frontend only. Do not place server secrets in VITE_* variables.
VITE_POCKETBASE_API_URL=https://buildanddo.com/hcgi/platform

# Datadog RUM (client-side public identifiers, not secrets).
# Datadog org site: us5.datadoghq.com
VITE_DD_APPLICATION_ID=
VITE_DD_CLIENT_TOKEN=
# Optional overrides. env is otherwise derived from the hostname, and version
# from the shipped commit (scripts/deploy/ship.py writes both at build time).
VITE_DD_ENV=
VITE_DD_VERSION=
# Percentages, 0-100. Defaults: sessions 100, replay 20, backend trace
# propagation 20. Lower the replay rate first if RUM volume needs trimming.
VITE_DD_SESSION_SAMPLE_RATE=
VITE_DD_REPLAY_SAMPLE_RATE=
VITE_DD_TRACE_SAMPLE_RATE=
